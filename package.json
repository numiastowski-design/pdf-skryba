{
  "name": "pdf-skryba",
  "version": "0.10.1",
  "description": "Reads a PDF into a structured representation, and checks that no word was lost on the way.",
  "keywords": [
    "pdf",
    "text-extraction",
    "document-parser",
    "tagged-pdf",
    "structure",
    "word-conservation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/numiastowski-design/pdf-skryba.git"
  },
  "homepage": "https://github.com/numiastowski-design/pdf-skryba#readme",
  "bugs": {
    "url": "https://github.com/numiastowski-design/pdf-skryba/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/types/lib/pdf.d.ts",
      "default": "./dist/index.js"
    },
    "./light": {
      "types": "./dist/types/lib/pdf-light.d.ts",
      "default": "./dist/light.js"
    },
    "./min": {
      "types": "./dist/types/lib/pdf.d.ts",
      "default": "./dist/index.min.js"
    },
    "./light/min": {
      "types": "./dist/types/lib/pdf-light.d.ts",
      "default": "./dist/light.min.js"
    },
    "./first-party": {
      "types": "./dist/types/lib/pdf-first-party.d.ts",
      "default": "./dist/first-party.js"
    },
    "./first-party/reader": {
      "types": "./dist/types/lib/pdf-first-party-reader.d.ts",
      "default": "./dist/first-party/reader.js"
    }
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 src scripts",
    "format:check": "prettier --check src scripts",
    "typecheck": "tsc --noEmit && node node_modules/typescript7/bin/tsc --noEmit",
    "lint:pack": "publint run --strict && attw --pack . --profile esm-only",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/.inputs.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY.md"
  ],
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "doc-ir": "^0.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.6.11",
    "esbuild": "0.28.2",
    "eslint": "10.16.0",
    "eslint-plugin-sonarjs": "4.2.3",
    "fast-check": "4.11.0",
    "jpeg-js": "0.4.4",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "5.1.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
